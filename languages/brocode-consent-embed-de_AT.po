#: includes/render.php:58
#, php-format
msgid "This content is provided by %1$s. Loading it sends data such as your IP address to %2$s."
msgstr "Dieser Inhalt wird von %1$s bereitgestellt. Beim Laden werden Daten wie deine IP-Adresse an %2$s übertragen."

#: includes/render.php:76
msgid "Privacy policy"
msgstr "Datenschutzerklärung"

