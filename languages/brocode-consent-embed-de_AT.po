#. Plugin Name of the plugin
#: brocode-consent-embed.php
msgid "BroCode Consent Embed"
msgstr "BroCode Consent Embed"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: brocode-consent-embed.php
msgid "https://brocode.at"
msgstr ""

#. Description of the plugin
#: brocode-consent-embed.php
msgid "Click-to-load embeds for Google Maps, Google Calendar, YouTube, Vimeo and OpenStreetMap. Nothing is loaded from the third party until the visitor consents. Also gates existing YouTube and Vimeo embeds, and honours the WP Consent API."
msgstr "Einbettungen per Klick für Google Maps, Google Kalender, YouTube, Vimeo und OpenStreetMap. Vom Drittanbieter wird erst nach Zustimmung etwas geladen. Sichert auch bestehende YouTube- und Vimeo-Einbettungen ab und berücksichtigt die WP Consent API."

#. Author of the plugin
#: brocode-consent-embed.php
msgid "Benjamin Rosenberger"
msgstr ""

#: build/consent-embed/render.php:44
msgid "Paste a Google Maps, Google Calendar, YouTube, Vimeo or OpenStreetMap link."
msgstr "Füge einen Link von Google Maps, Google Kalender, YouTube, Vimeo oder OpenStreetMap ein."

