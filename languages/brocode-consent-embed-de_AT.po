#. translators: %s: service name
#: build/consent-section/index.js:2
#, js-format
msgid "Loads only after consent to %s"
msgstr "Lädt erst nach Zustimmung zu %s"

#: build/consent-section/index.js:2
msgid "Name the service in the block settings. Until then nothing renders on the site."
msgstr "Gib den Dienst in den Block-Einstellungen an. Bis dahin wird auf der Website nichts angezeigt."

#: build/consent-section/index.js:2
msgid "No service named yet."
msgstr "Noch kein Dienst angegeben."

#: build/consent-embed/block.json
msgctxt "block title"
msgid "Consent Embed"
msgstr "Einbettung mit Zustimmung"

#: build/consent-embed/block.json
msgctxt "block description"
msgid "Google Maps, Google Calendar, YouTube, Vimeo or OpenStreetMap embed that only loads after the visitor clicks to consent."
msgstr "Einbettung von Google Maps, Google Kalender, YouTube, Vimeo oder OpenStreetMap, die erst nach einem Klick zur Zustimmung lädt."

