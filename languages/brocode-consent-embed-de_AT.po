#. Plugin Name of the plugin
#: brocode-consent-embed.php
msgid "BroCode Consent Embed"
msgstr "BroCode Consent Embed"

#. Plugin URI of the plugin
#: brocode-consent-embed.php
msgid "https://brocode.at/modules/brocode-consent-embed/"
msgstr ""

#. Description of the plugin
#: brocode-consent-embed.php
msgid "Click-to-load embeds for Google Maps, Google Calendar, YouTube, Vimeo and OpenStreetMap, plus a consent section that holds back any blocks until the visitor agrees. Also gates existing YouTube and Vimeo embeds, and honours the WP Consent API."
msgstr "Einbettungen per Klick für Google Maps, Google Kalender, YouTube, Vimeo und OpenStreetMap, dazu ein Zustimmungsbereich, der beliebige Blöcke bis zur Zustimmung zurückhält. Sichert auch bestehende YouTube- und Vimeo-Einbettungen ab und berücksichtigt die WP Consent API."

#. Author of the plugin
#: brocode-consent-embed.php
msgid "Benjamin Rosenberger"
msgstr ""

#. Author URI of the plugin
#: brocode-consent-embed.php
msgid "https://brocode.at"
msgstr ""

