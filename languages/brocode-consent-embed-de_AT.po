#: build/consent-embed/index.js:1
#: build/consent-section/index.js:1
#, js-format
msgid "Leave empty for the default text. %s is replaced with the service name."
msgstr "Leer lassen für den Standardtext. %s wird durch den Namen des Dienstes ersetzt."

#: build/consent-embed/index.js:1
msgid "Height (px, maps and calendars)"
msgstr "Höhe (px, Karten und Kalender)"

#: build/consent-section/index.js:1
