msgstr "Präferenzen"

#: build/consent-section/index.js:1
msgid "Functional"
msgstr "Funktional"

#: build/consent-section/index.js:1
msgid "Service"
msgstr "Dienst"

#: build/consent-section/index.js:1
msgid "Other service…"
msgstr "Anderer Dienst …"

#: build/consent-section/index.js:1
msgid "Service name"
msgstr "Name des Dienstes"

#: build/consent-section/index.js:1
msgid "Shown on the button, e.g. Instagram or Calendly. Visitors who tick \"always load\" are remembered per service name."
msgstr "Steht auf dem Button, z. B. Instagram oder Calendly. „Immer laden“ wird pro Dienstname gespeichert."

#: build/consent-section/index.js:1
msgid "Company receiving the data"
msgstr "Unternehmen, das die Daten erhält"

#: build/consent-section/index.js:1
