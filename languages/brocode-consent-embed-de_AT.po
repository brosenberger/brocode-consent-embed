#: build/consent-embed/index.js:1
msgid "Embed"
msgstr "Einbettung"

#: build/consent-embed/index.js:1
msgid "Embed link"
msgstr "Einbettungs-Link"

#: build/consent-embed/index.js:1
msgid "Google Maps or Google Calendar embed link, a YouTube or Vimeo video link, or an OpenStreetMap embed link. A pasted <iframe> snippet works too."
msgstr "Einbettungs-Link von Google Maps oder Google Kalender, ein YouTube- oder Vimeo-Videolink oder ein OpenStreetMap-Einbettungslink. Ein eingefügter <iframe>-Code funktioniert auch."

