{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "brocode/consent-embed",
	"version": "1.0.0",
	"title": "Consent Embed",
	"category": "embed",
	"icon": "privacy",
	"description": "Google Maps, Google Calendar, YouTube, Vimeo or OpenStreetMap embed that only loads after the visitor clicks to consent.",
	"keywords": [ "maps", "calendar", "youtube", "vimeo", "gdpr", "privacy", "consent", "embed" ],
	"textdomain": "brocode-consent-embed",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true
		}
	},
	"attributes": {
		"url": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"height": {
			"type": "number",
			"default": 450
		},
		"notice": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
